<%- include('partials/head') %>

<section class="wrap section narrow">
  <h1>Log in</h1>

  <%- include('partials/errors', { errors: errors }) %>

  <form method="post" action="/login" class="stack">
    <input type="hidden" name="next" value="<%= next %>">
    <label>
      <span>Email</span>
      <input type="email" name="email" required autocomplete="email" value="<%= form.email || '' %>">
    </label>
    <label>
      <span>Password</span>
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button class="btn" type="submit">Log in</button>
  </form>

  <p class="alt">New to the building board? <a href="/signup">Create an account</a>.</p>
  <p class="fine">Locked out? Call or email User Help at the bottom of this page and we'll reset it for you.</p>
</section>

<%- include('partials/foot') %>
